ADMIN_PASSWORD=CambiaQuesta_Password_Sicura!
OPERATOR_SECRET=CambiaQuesta_Password_Operatori
# Token API Apify per Google Maps Scraper (opzionale se inserito da interfaccia)
APIFY_TOKEN=
PORT=3000
NODE_ENV=development

# Modalità demo: mostra l'accesso rapido "clicca sul nome" senza password
# sulla schermata di login, oltre al vero login username/password (sempre attivo).
# IMPORTANTE: quando l'app va in produzione sulla VPS, imposta DEMO_MODE=false
# per obbligare ogni telefonista e ogni agente a loggarsi con le proprie credenziali.
DEMO_MODE=true

# Integrazione Google Calendar per-agente: ogni agente collega il PROPRIO
# account Google (OAuth2) dal proprio profilo. Senza queste variabili il
# bottone "Collega Google Calendar" resta disattivato e nessun evento viene
# sincronizzato. Vanno create su https://console.cloud.google.com/
# (abilitare "Google Calendar API", creare credenziali OAuth 2.0 di tipo
# "Applicazione Web" e aggiungere GOOGLE_REDIRECT_URI tra gli URI di reindirizzamento autorizzati).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In locale: http://localhost:3000/api/auth/google/callback
# Sulla VPS: https://tuodominio.it/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
